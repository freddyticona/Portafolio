# Normaliza saltos de línea: LF en el repositorio sin importar el SO del contribuidor.
# Evita avisos "LF will be replaced by CRLF" y diffs espurios entre Windows/Linux/macOS.
* text=auto eol=lf

# Asegura LF explícito en archivos de texto críticos del proyecto.
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.svg  text eol=lf

# shell scripts (ci, scripts/)
*.sh   text eol=lf

# Asegura CRLF en scripts de Windows (mantienen compatibilidad cmd/PowerShell).
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Tratar binarios explícitamente (evita corrupción).
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif  binary
*.ico  binary
*.mp4  binary
*.mp3  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary
*.zip  binary
